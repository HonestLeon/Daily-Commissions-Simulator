{
  "$schema": "https://raw.githubusercontent.com/nicholasio/bonsaidb/main/tauri.conf.schema.json",
  "productName": "每日委托模拟器",
  "version": "0.2.6",
  "identifier": "com.liurr.lightweight-sticky-notes",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "每日委托模拟器",
        "width": 620,
        "height": 500,
        "minWidth": 340,
        "minHeight": 300,
        "resizable": true,
        "decorations": false,
        "transparent": true,
        "visible": false,
        "alwaysOnTop": false
      },
      {
        "label": "bubble",
        "title": "每日委托模拟器 · 气泡",
        "width": 220,
        "height": 64,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "visible": false,
        "alwaysOnTop": true,
        "focusable": false,
        "skipTaskbar": true,
        "shadow": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"]
  }
}
